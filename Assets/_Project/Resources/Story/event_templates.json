        "steps": [
          {
            "type": "face",
            "actor": "${npc}",
            "facing": "down"
          },
          {
            "type": "say",
            "speaker": "${npc}",
            "text": "${intro}"
          },
          {
            "type": "move",
            "actor": "player",
            "x": "${px}",
            "y": "${py}"
          },
          {
            "type": "face",
            "actor": "player",
            "facing": "up"
          },
          {
            "type": "anim",
            "actor": "${npc}",
            "name": "${greet}",
