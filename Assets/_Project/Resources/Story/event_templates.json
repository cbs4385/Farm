        "npc",
        "map",
        "px",
        "py",
        "intro",
        "talk",
        "after"
      ],
      "defaults": {
        "when": "true",
        "reward": [],
        "emote": "ellipsis",
        "greet": "wave"
      },
      "event": {
        "trigger": "map",
        "map": "${map}",
        "priority": 6,
        "condition": "${when}",
        "steps": [
          {
            "type": "face",
            "actor": "${npc}",
            "facing": "down"
          },
          {
            "type": "say",
            "speaker": "${npc}",
            "text": "${intro}"
          },
          {
            "type": "move",
            "actor": "player",
            "x": "${px}",
            "y": "${py}"
          },
          {
            "type": "face",
            "actor": "player",
            "facing": "up"
          },
          {
            "type": "anim",
            "actor": "${npc}",
            "name": "${greet}",
            "seconds": 1.2,
            "async": true
          },
          {
            "type": "emote",
            "actor": "${npc}",
            "name": "${emote}",
            "seconds": 1.2,
            "async": true
          },
          {
            "type": "dialogue",
            "dialogue": "${talk}"
          },
          {
            "type": "say",
            "speaker": "${npc}",
            "text": "${after}"
          },
          {
            "type": "effects",
            "effects": [
              "flag:event.${id}"
            ]
          },
          {
            "type": "effects",
            "effects": "${reward}"
          }
        ]
      }
    },
    {
