        "map",
        "px",
        "py",
        "intro",
        "talk",
        "after"
      ],
      "defaults": {
        "when": "true",
        "reward": []
      },
      "event": {
        "trigger": "map",
        "map": "${map}",
        "priority": 6,
        "condition": "${when}",
        "steps": [
          {
            "type": "face",
            "actor": "${npc}",
            "facing": "down"
          },
          {
            "type": "say",
            "speaker": "${npc}",
            "text": "${intro}"
          },
          {
            "type": "move",
            "actor": "player",
            "x": "${px}",
            "y": "${py}"
          },
          {
            "type": "face",
            "actor": "player",
            "facing": "up"
          },
          {
            "type": "letterbox",
            "name": "on",
