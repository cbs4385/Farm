{
  "eventTemplates": [
    {
      "id": "shared_activity",
      "description": "The villager shows the player something they do (cooking, mending, tuning). A gesture and an emote during the activity, then a closing line and a reward.",
      "params": [
        "npc",
        "map",
        "px",
        "py",
        "intro",
        "doing",
        "wrap"
      ],
      "defaults": {
        "when": "true",
        "gesture": "nod",
        "emote": "note",
        "reward": []
      },
      "event": {
        "trigger": "map",
        "map": "${map}",
        "priority": 6,
        "condition": "${when}",
        "steps": [
          {
            "type": "face",
            "actor": "${npc}",
            "facing": "down"
          },
          {
            "type": "say",
            "speaker": "${npc}",
            "text": "${intro}"
          },
          {
            "type": "move",
            "actor": "player",
            "x": "${px}",
            "y": "${py}"
          },
          {
            "type": "face",
            "actor": "player",
            "facing": "up"
          },
          {
            "type": "emote",
            "actor": "${npc}",
            "name": "${emote}",
            "seconds": 1.2,
            "async": true
          },
          {
            "type": "anim",
            "actor": "${npc}",
            "name": "${gesture}",
            "seconds": 0.8
          },
          {
            "type": "waitFor",
            "actor": "${npc}"
          },
          {
            "type": "say",
            "speaker": "${npc}",
            "text": "${doing}"
          },
          {
            "type": "say",
            "speaker": "${npc}",
            "text": "${wrap}"
          },
          {
            "type": "effects",
            "effects": [
              "flag:event.${id}"
            ]
          },
          {
            "type": "effects",
            "effects": "${reward}"
          }
        ]
      }
    },
    {
      "id": "conversation",
      "description": "A plain scene with a conversation: the villager says something, the player moves in, a dialogue with choices follows (its flags are what later lines refer to), then a closing line.",
